<?xml version="1.0" encoding="utf-8"?>
<!--
  The setup wizard, drawn by WiX's thmutil. Generated by custom-installer-wix.

  Control Names are a contract, not labels: wixstdba looks each one up by name to wire a button, bind
  the progress bar or fill in the failure text. Renaming InstallButton or OverallCalculatedProgressbar
  silently breaks what it drives. Change geometry, colours and text freely; keep the names.

  The panel is light on purpose. thmutil draws Checkbox, Progressbar and Editbox as plain Win32 controls
  whose text is always near-black, so a dark panel makes checkbox labels unreadable. The brand colour is
  carried by the sidebar image and the button images instead (Assets\*.png, drawn from the app icon).

  Buttons are images because a thmutil Button without one is a grey Win32 slab. Each state is its own
  88x26 file: SourceX/SourceY index a theme-level image, so a sprite sheet fails to parse and the
  bootstrapper exits before drawing anything. Every graphic button needs ButtonImage, ButtonHoverImage
  and ButtonSelectedImage, or the theme fails to load.

  Negative X/Y are offsets from the right/bottom edge; negative Width/Height stop that far short of it.
-->
<Theme xmlns="http://wixtoolset.org/schemas/v4/thmutil">

  <!-- Font 0 also paints the window background. Every other font repeats that background so labels
       do not draw their own rectangle. Fonts 5-7 have no background: they sit on button images. -->
  <Font Id="0" Height="-12" Weight="500" Foreground="1F2328" Background="F5F6F8">Segoe UI</Font>
  <Font Id="1" Height="-24" Weight="600" Foreground="1F2328" Background="F5F6F8">Segoe UI</Font>
  <Font Id="2" Height="-18" Weight="500" Foreground="6E7781" Background="F5F6F8">Segoe UI</Font>
  <Font Id="3" Height="-12" Weight="500" Foreground="1F2328" Background="F5F6F8">Segoe UI</Font>
  <Font Id="4" Height="-12" Weight="500" Foreground="6E7781" Background="F5F6F8">Segoe UI</Font>
  <Font Id="5" Height="-12" Weight="600" Foreground="FFFFFF">Segoe UI</Font>
  <Font Id="6" Height="-12" Weight="500" Foreground="1F2328">Segoe UI</Font>
  <Font Id="7" Height="-12" Weight="600" Foreground="8C949F">Segoe UI</Font>

  <Window Width="600" Height="450" HexStyle="100a0000" FontId="0" Caption="#(loc.Caption)" IconFile="AppIcon.ico">

    <Page Name="Help">
      <ImageControl X="20" Y="20" Width="64" Height="64" ImageFile="logo.png" />
      <Label X="100" Y="26" Width="-20" Height="34" FontId="1" DisablePrefix="yes">#(loc.Title)</Label>
      <Label X="20" Y="104" Width="-20" Height="26" FontId="2" DisablePrefix="yes">#(loc.HelpHeader)</Label>
      <Label X="20" Y="140" Width="-20" Height="-60" FontId="3" DisablePrefix="yes">#(loc.HelpText)</Label>
      <Button Name="HelpCloseButton" X="-20" Y="-18" Width="88" Height="26" TabStop="yes" FontId="6">
        <Text>#(loc.HelpCloseButton)</Text>
        <ButtonImage ImageFile="ButtonSecondary.png" />
        <ButtonHoverImage ImageFile="ButtonSecondaryHover.png" />
        <ButtonSelectedImage ImageFile="ButtonSecondaryPressed.png" />
        <ButtonFocusImage ImageFile="ButtonSecondaryHover.png" />
        <CloseWindowAction />
      </Button>
    </Page>

    <Page Name="Loading">
      <Label X="200" Y="70" Width="-20" Height="26" FontId="2" DisablePrefix="yes" Visible="no"
             Name="CheckingForUpdatesLabel" />
    </Page>

    <Page Name="Install">
      <ImageControl X="0" Y="0" Width="165" Height="450" ImageFile="logoside.png" />

      <Label X="196" Y="22" Width="-20" Height="32" FontId="1" DisablePrefix="yes">#(loc.Title)</Label>
      <Label X="196" Y="58" Width="-20" Height="18" FontId="4" DisablePrefix="yes">#(loc.InstallMessage)</Label>

      <Label X="196" Y="90" Width="-20" Height="16" FontId="4" DisablePrefix="yes">#(loc.ShortcutsHeader)</Label>
      <!-- Bound by name to the DesktopShortcut variable in Bundle.wxs, which is passed to the .msi. -->
      <Checkbox Name="DesktopShortcut" X="196" Y="110" Width="-20" Height="20" TabStop="yes" FontId="3">#(loc.DesktopShortcutCheckbox)</Checkbox>

      <Label X="196" Y="146" Width="-20" Height="16" FontId="4" DisablePrefix="yes">#(loc.LicenseHeader)</Label>
      <!-- Filled with Assets\License.rtf by wixstdba; the name is the contract. HexStyle 800000 = WS_BORDER. -->
      <Richedit Name="EulaRichedit" X="196" Y="166" Width="-20" Height="-84"
                TabStop="yes" FontId="0" HexStyle="800000" />
      <Checkbox Name="EulaAcceptCheckbox" X="196" Y="-56" Width="-20" Height="20" TabStop="yes"
                FontId="3" HideWhenDisabled="yes">#(loc.InstallAcceptCheckbox)</Checkbox>

      <Label Name="InstallVersion" X="196" Y="-20" Width="190" Height="16" FontId="4"
             DisablePrefix="yes" VisibleCondition="WixStdBAShowVersion">#(loc.InstallVersion)</Label>

      <Button Name="InstallButton" X="-116" Y="-18" Width="88" Height="26" TabStop="yes" FontId="5">
        <Text>#(loc.InstallInstallButton)</Text>
        <ButtonImage ImageFile="ButtonPrimary.png" />
        <ButtonHoverImage ImageFile="ButtonPrimaryHover.png" />
        <ButtonSelectedImage ImageFile="ButtonPrimaryPressed.png" />
        <ButtonFocusImage ImageFile="ButtonPrimaryHover.png" />
      </Button>
      <!--
        wixstdba disables InstallButton until the licence is accepted, but thmutil has no disabled-state
        button image, so a disabled image button still looks live. This inert stand-in, declared after it
        so it paints on top, covers it while the box is unticked. Its name is unknown to wixstdba, so it is
        wired to nothing. (A VisibleCondition on InstallButton itself is overridden by wixstdba.)
      -->
      <Button Name="InstallBlockedButton" X="-116" Y="-18" Width="88" Height="26"
              TabStop="no" FontId="7" VisibleCondition="NOT EulaAcceptCheckbox">
        <Text>#(loc.InstallInstallButton)</Text>
        <ButtonImage ImageFile="ButtonDisabled.png" />
        <ButtonHoverImage ImageFile="ButtonDisabled.png" />
        <ButtonSelectedImage ImageFile="ButtonDisabled.png" />
      </Button>
      <Button Name="InstallCancelButton" X="-20" Y="-18" Width="88" Height="26" TabStop="yes" FontId="6">
        <Text>#(loc.InstallCancelButton)</Text>
        <ButtonImage ImageFile="ButtonSecondary.png" />
        <ButtonHoverImage ImageFile="ButtonSecondaryHover.png" />
        <ButtonSelectedImage ImageFile="ButtonSecondaryPressed.png" />
        <ButtonFocusImage ImageFile="ButtonSecondaryHover.png" />
        <CloseWindowAction />
      </Button>
    </Page>

    <Page Name="Progress">
      <ImageControl X="20" Y="20" Width="64" Height="64" ImageFile="logo.png" />
      <Label X="100" Y="26" Width="-20" Height="34" FontId="1" DisablePrefix="yes">#(loc.Title)</Label>
      <Label X="20" Y="104" Width="-20" Height="26" FontId="2" DisablePrefix="yes">#(loc.ProgressHeader)</Label>
      <Label X="20" Y="160" Width="80" Height="18" FontId="4" DisablePrefix="yes">#(loc.ProgressLabel)</Label>
      <Label Name="OverallProgressPackageText" X="104" Y="160" Width="-20" Height="18" FontId="3"
             DisablePrefix="yes">#(loc.OverallProgressPackageText)</Label>
      <Progressbar Name="OverallCalculatedProgressbar" X="20" Y="186" Width="-20" Height="16" />
      <Button Name="ProgressCancelButton" X="-20" Y="-18" Width="88" Height="26" TabStop="yes" FontId="6">
        <Text>#(loc.ProgressCancelButton)</Text>
        <ButtonImage ImageFile="ButtonSecondary.png" />
        <ButtonHoverImage ImageFile="ButtonSecondaryHover.png" />
        <ButtonSelectedImage ImageFile="ButtonSecondaryPressed.png" />
        <ButtonFocusImage ImageFile="ButtonSecondaryHover.png" />
      </Button>
    </Page>

    <Page Name="Modify">
      <ImageControl X="0" Y="0" Width="165" Height="450" ImageFile="logoside.png" />
      <Label X="196" Y="26" Width="-20" Height="34" FontId="1" DisablePrefix="yes">#(loc.Title)</Label>
      <Label X="196" Y="68" Width="-20" Height="26" FontId="2" DisablePrefix="yes">#(loc.ModifyHeader)</Label>
      <Label X="196" Y="102" Width="-20" Height="56" FontId="3" DisablePrefix="yes">#(loc.ModifyMessage)</Label>
      <Button Name="RepairButton" X="-212" Y="-18" Width="88" Height="26" TabStop="yes" FontId="6" HideWhenDisabled="yes">
        <Text>#(loc.ModifyRepairButton)</Text>
        <ButtonImage ImageFile="ButtonSecondary.png" />
        <ButtonHoverImage ImageFile="ButtonSecondaryHover.png" />
        <ButtonSelectedImage ImageFile="ButtonSecondaryPressed.png" />
        <ButtonFocusImage ImageFile="ButtonSecondaryHover.png" />
      </Button>
      <Button Name="UninstallButton" X="-116" Y="-18" Width="88" Height="26" TabStop="yes" FontId="5">
        <Text>#(loc.ModifyUninstallButton)</Text>
        <ButtonImage ImageFile="ButtonPrimary.png" />
        <ButtonHoverImage ImageFile="ButtonPrimaryHover.png" />
        <ButtonSelectedImage ImageFile="ButtonPrimaryPressed.png" />
        <ButtonFocusImage ImageFile="ButtonPrimaryHover.png" />
      </Button>
      <Button Name="ModifyCancelButton" X="-20" Y="-18" Width="88" Height="26" TabStop="yes" FontId="6">
        <Text>#(loc.ModifyCancelButton)</Text>
        <ButtonImage ImageFile="ButtonSecondary.png" />
        <ButtonHoverImage ImageFile="ButtonSecondaryHover.png" />
        <ButtonSelectedImage ImageFile="ButtonSecondaryPressed.png" />
        <ButtonFocusImage ImageFile="ButtonSecondaryHover.png" />
        <CloseWindowAction />
      </Button>
    </Page>

    <Page Name="Success">
      <ImageControl X="0" Y="0" Width="165" Height="450" ImageFile="logoside.png" />
      <Label X="196" Y="26" Width="-20" Height="34" FontId="1" DisablePrefix="yes">#(loc.Title)</Label>
      <Label X="196" Y="68" Width="-20" Height="26" FontId="2" DisablePrefix="yes">
        <Text>#(loc.SuccessHeader)</Text>
        <Text Condition="WixBundleAction = 2">#(loc.SuccessLayoutHeader)</Text>
        <Text Condition="WixBundleAction = 3">#(loc.SuccessUninstallHeader)</Text>
        <Text Condition="WixBundleAction = 4">#(loc.SuccessUninstallHeader)</Text>
        <Text Condition="WixBundleAction = 5">#(loc.SuccessCacheHeader)</Text>
        <Text Condition="WixBundleAction = 6">#(loc.SuccessInstallHeader)</Text>
        <Text Condition="WixBundleAction = 7">#(loc.SuccessModifyHeader)</Text>
        <Text Condition="WixBundleAction = 8">#(loc.SuccessRepairHeader)</Text>
      </Label>
      <Label X="196" Y="-106" Width="-20" Height="36" FontId="4" DisablePrefix="yes"
             VisibleCondition="WixStdBARestartRequired">#(loc.SuccessRestartText)</Label>
      <Button Name="SuccessRestartButton" X="-212" Y="-18" Width="88" Height="26" TabStop="yes" FontId="6" HideWhenDisabled="yes">
        <Text>#(loc.SuccessRestartButton)</Text>
        <ButtonImage ImageFile="ButtonSecondary.png" />
        <ButtonHoverImage ImageFile="ButtonSecondaryHover.png" />
        <ButtonSelectedImage ImageFile="ButtonSecondaryPressed.png" />
        <ButtonFocusImage ImageFile="ButtonSecondaryHover.png" />
      </Button>
      <Button Name="LaunchButton" X="-116" Y="-18" Width="88" Height="26" TabStop="yes" FontId="5" HideWhenDisabled="yes">
        <Text>#(loc.SuccessLaunchButton)</Text>
        <ButtonImage ImageFile="ButtonPrimary.png" />
        <ButtonHoverImage ImageFile="ButtonPrimaryHover.png" />
        <ButtonSelectedImage ImageFile="ButtonPrimaryPressed.png" />
        <ButtonFocusImage ImageFile="ButtonPrimaryHover.png" />
      </Button>
      <Button Name="SuccessCloseButton" X="-20" Y="-18" Width="88" Height="26" TabStop="yes" FontId="6">
        <Text>#(loc.SuccessCloseButton)</Text>
        <ButtonImage ImageFile="ButtonSecondary.png" />
        <ButtonHoverImage ImageFile="ButtonSecondaryHover.png" />
        <ButtonSelectedImage ImageFile="ButtonSecondaryPressed.png" />
        <ButtonFocusImage ImageFile="ButtonSecondaryHover.png" />
        <CloseWindowAction />
      </Button>
    </Page>

    <Page Name="Failure">
      <ImageControl X="0" Y="0" Width="165" Height="450" ImageFile="logoside.png" />
      <Label X="196" Y="26" Width="-20" Height="34" FontId="1" DisablePrefix="yes">#(loc.Title)</Label>
      <Label X="196" Y="68" Width="-20" Height="26" FontId="2" DisablePrefix="yes">
        <Text>#(loc.FailureHeader)</Text>
        <Text Condition="WixBundleAction = 3">#(loc.FailureUninstallHeader)</Text>
        <Text Condition="WixBundleAction = 4">#(loc.FailureUninstallHeader)</Text>
        <Text Condition="WixBundleAction = 7">#(loc.FailureModifyHeader)</Text>
        <Text Condition="WixBundleAction = 8">#(loc.FailureRepairHeader)</Text>
      </Label>
      <Hypertext Name="FailureLogFileLink" X="196" Y="106" Width="-20" Height="56" FontId="4"
                 TabStop="yes" HideWhenDisabled="yes">#(loc.FailureHyperlinkLogText)</Hypertext>
      <Hypertext Name="FailureMessageText" X="196" Y="172" Width="-20" Height="80" FontId="3"
                 TabStop="yes" HideWhenDisabled="yes" />
      <Label X="196" Y="-106" Width="-20" Height="36" FontId="4" DisablePrefix="yes"
             VisibleCondition="WixStdBARestartRequired">#(loc.FailureRestartText)</Label>
      <Button Name="FailureRestartButton" X="-116" Y="-18" Width="88" Height="26" TabStop="yes" FontId="6" HideWhenDisabled="yes">
        <Text>#(loc.FailureRestartButton)</Text>
        <ButtonImage ImageFile="ButtonSecondary.png" />
        <ButtonHoverImage ImageFile="ButtonSecondaryHover.png" />
        <ButtonSelectedImage ImageFile="ButtonSecondaryPressed.png" />
        <ButtonFocusImage ImageFile="ButtonSecondaryHover.png" />
      </Button>
      <Button Name="FailureCloseButton" X="-20" Y="-18" Width="88" Height="26" TabStop="yes" FontId="6">
        <Text>#(loc.FailureCloseButton)</Text>
        <ButtonImage ImageFile="ButtonSecondary.png" />
        <ButtonHoverImage ImageFile="ButtonSecondaryHover.png" />
        <ButtonSelectedImage ImageFile="ButtonSecondaryPressed.png" />
        <ButtonFocusImage ImageFile="ButtonSecondaryHover.png" />
        <CloseWindowAction />
      </Button>
    </Page>

  </Window>
</Theme>
