<?xml version="1.0" encoding="utf-8"?>
<!--
  Every string Theme.xml references as #(loc.Id). Generated by custom-installer-wix.
  Ids that wixstdba looks up itself (ConfirmCancelMessage, FilesInUse*, ExecuteUpgradeRelatedBundleMessage)
  are kept even though Theme.xml never names them; a missing one shows up as a raw id in a dialog.
  [WixBundleName] and [WixBundleVersion] are filled in by Burn.
-->
<WixLocalization Culture="en-us" Language="1033" xmlns="http://wixtoolset.org/schemas/v4/wxl">

  <String Id="Caption" Value="[WixBundleName] Setup" />
  <String Id="Title" Value="[WixBundleName]" />
  <String Id="CheckingForUpdatesLabel" Value="Checking for updates" />
  <String Id="UpdateButton" Value="&amp;Update to version [WixStdBAUpdateAvailable]" />

  <String Id="InstallHeader" Value="Install [WixBundleName]" />
  <String Id="InstallMessage" Value="Installs for you only, under your user profile - no administrator rights needed." />
  <String Id="LicenseHeader" Value="LICENSE AGREEMENT" />
  <String Id="InstallVersion" Value="Version [WixBundleVersion]" />
  <String Id="ShortcutsHeader" Value="SHORTCUTS" />
  <String Id="DesktopShortcutCheckbox" Value="Create a &amp;desktop shortcut" />
  <String Id="InstallAcceptCheckbox" Value="I &amp;agree to the license terms" />
  <String Id="InstallInstallButton" Value="&amp;Install" />
  <String Id="InstallCancelButton" Value="&amp;Cancel" />

  <String Id="ProgressHeader" Value="Installing" />
  <String Id="ProgressLabel" Value="Progress:" />
  <String Id="OverallProgressPackageText" Value="Starting..." />
  <String Id="ProgressCancelButton" Value="&amp;Cancel" />

  <String Id="ModifyHeader" Value="Manage [WixBundleName]" />
  <String Id="ModifyMessage" Value="Repair reinstalls the current version over itself. Uninstall removes the app and its shortcuts." />
  <String Id="ModifyRepairButton" Value="&amp;Repair" />
  <String Id="ModifyUninstallButton" Value="&amp;Uninstall" />
  <String Id="ModifyCancelButton" Value="&amp;Close" />

  <String Id="SuccessHeader" Value="Done" />
  <String Id="SuccessInstallHeader" Value="[WixBundleName] is installed" />
  <String Id="SuccessCacheHeader" Value="Download complete" />
  <String Id="SuccessLayoutHeader" Value="Layout complete" />
  <String Id="SuccessModifyHeader" Value="Changes applied" />
  <String Id="SuccessRepairHeader" Value="Repair complete" />
  <String Id="SuccessUninstallHeader" Value="[WixBundleName] has been removed" />
  <String Id="SuccessLaunchButton" Value="&amp;Launch" />
  <String Id="SuccessRestartText" Value="Restart your computer to finish." />
  <String Id="SuccessRestartButton" Value="&amp;Restart" />
  <String Id="SuccessCloseButton" Value="&amp;Close" />

  <String Id="FailureHeader" Value="Setup did not finish" />
  <String Id="FailureInstallHeader" Value="Setup did not finish" />
  <String Id="FailureUninstallHeader" Value="Uninstall did not finish" />
  <String Id="FailureModifyHeader" Value="Changes were not applied" />
  <String Id="FailureRepairHeader" Value="Repair did not finish" />
  <String Id="FailureCacheHeader" Value="Download did not finish" />
  <String Id="FailureLayoutHeader" Value="Layout did not finish" />
  <String Id="FailureHyperlinkLogText" Value="Nothing was changed on your computer. The &lt;a href=&quot;#&quot;&gt;log file&lt;/a&gt; has the details." />
  <String Id="FailureRestartText" Value="Restart your computer to finish undoing the changes." />
  <String Id="FailureRestartButton" Value="&amp;Restart" />
  <String Id="FailureCloseButton" Value="&amp;Close" />

  <String Id="HelpHeader" Value="Command line" />
  <String Id="HelpText" Value="/install | /repair | /uninstall - installs, repairs or removes [WixBundleName]. Install is the default.&#xA;&#xA;/passive | /quiet - minimal UI with no prompts, or no UI at all.&#xA;&#xA;DesktopShortcut=0 - no desktop shortcut.&#xA;/norestart - never restart the computer.&#xA;/log log.txt - write a log to a specific file. By default one is written to %TEMP%." />
  <String Id="HelpCloseButton" Value="&amp;Close" />

  <String Id="ConfirmCancelMessage" Value="Cancel this installation?" />
  <String Id="ExecuteUpgradeRelatedBundleMessage" Value="Previous version" />
  <String Id="FilesInUseTitle" Value="Files In Use" />
  <String Id="FilesInUseLabel" Value="[WixBundleName] is open. Close it to continue:" />
  <String Id="FilesInUseCloseRadioButton" Value="Close the &amp;applications and attempt to restart them." />
  <String Id="FilesInUseNetfxCloseRadioButton" Value="Close the &amp;applications." />
  <String Id="FilesInUseDontCloseRadioButton" Value="&amp;Do not close applications. A reboot will be required." />
  <String Id="FilesInUseRetryButton" Value="&amp;Retry" />
</WixLocalization>
