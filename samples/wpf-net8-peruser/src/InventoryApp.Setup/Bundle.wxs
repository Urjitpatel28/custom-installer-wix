<?xml version="1.0" encoding="utf-8"?>
<!--
  ContosoInventorySetup.exe: the setup users download, and the only file this project outputs.
  Generated by custom-installer-wix.

  Why wrap a single .msi in a bootstrapper:
    - The icon. Windows draws every .msi with msiexec's icon and no package property changes that,
      so only an .exe can carry the app's icon in Explorer, on the taskbar and in a download bar.
    - The wizard. Assets\Theme.xml is a branded, single-page wizard instead of WixUI's stock dialogs.

  NEVER change UpgradeCode. It is this bundle's own, deliberately different from the .msi's: they are
  separate upgrade families, and sharing one would make Burn treat its own payload as a related bundle.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Bundle Name="Contoso Inventory"
          Manufacturer="Contoso Ltd"
          Version="!(bind.packageVersion.MainPackage)"
          UpgradeCode="28DD322D-EF02-4AE6-99B5-075EF04B05B4"
          IconSourceFile="$(sys.SOURCEFILEDIR)..\InventoryApp\Assets\app.ico"
          AboutUrl="https://contoso.example"
          Compressed="yes">

    <!--
      The desktop-shortcut checkbox. The default is for a first install only: the search below reads
      back what the previous install recorded, so the checkbox comes up showing the user's last answer
      and an unattended upgrade (setup.exe /passive) keeps it. Persisted="yes" does not do this - Burn
      persists into a bundle registration, and every new version is a new registration.
      Overridable from the command line: ContosoInventorySetup.exe DesktopShortcut=0
    -->
    <Variable Name="DesktopShortcut" Type="numeric" Value="1" bal:Overridable="yes" />
    <util:RegistrySearch Id="RememberDesktopShortcut" Root="HKCU" Key="Software\Contoso Ltd\Contoso Inventory"
                         Value="DesktopShortcut" Result="value" Variable="DesktopShortcut" />

    <!-- The Start menu checkbox, remembered the same way. "StartMenu", not "StartMenuShortcut": that name
         is the shortcut component's own key path in installs from earlier generators. -->
    <Variable Name="StartMenuShortcut" Type="numeric" Value="1" bal:Overridable="yes" />
    <util:RegistrySearch Id="RememberStartMenuShortcut" Root="HKCU" Key="Software\Contoso Ltd\Contoso Inventory"
                         Value="StartMenu" Result="value" Variable="StartMenuShortcut" />

    <!--
      The install folder: the default for a first install, overridable (ContosoInventorySetup.exe
      InstallFolder=D:\Apps\X), and otherwise whatever the installed version recorded. ProductInstalled
      locks the folder field in Theme.xml: an upgrade goes where the app already is (moving an installed
      app is an uninstall and a fresh install). The key exists for installs from before the folder was
      recorded too; those are in the default folder.
    -->
    <Variable Name="InstallFolder" Type="formatted" Value="[LocalAppDataFolder]Programs\Contoso Inventory" bal:Overridable="yes" />
    <util:RegistrySearch Id="RememberInstallFolder" Root="HKCU" Key="Software\Contoso Ltd\Contoso Inventory"
                         Value="InstallFolder" Result="value" Variable="InstallFolder" />
    <util:RegistrySearch Id="DetectInstalledProduct" Root="HKCU" Key="Software\Contoso Ltd\Contoso Inventory"
                         Result="exists" Variable="ProductInstalled" />

    <!-- Enables the Launch button on the final page. -->
    <Variable Name="LaunchTarget" Type="formatted" Value="[InstallFolder]\InventoryApp.exe" />

    <BootstrapperApplication>
      <!--
        ThemeFile replaces the stock layout wholesale, but Theme still has to name a stock theme:
        that is what writes wixstdba's settings into the bundle (Theme="none" builds, then exits at
        start-up with "manifest is missing wixstdba information"). With a licence, rtfLicense shows it
        inside the wizard instead of opening the .rtf in Word. Without one, hyperlinkLicense with an
        empty LicenseUrl is the stock way to say "no licence"; Theme.xml has no licence controls then.

        The stock theme already carries a logo.png, so ours goes through LogoFile, which replaces it;
        a second Payload of the same name fails the build (WIX8002). Every other image Theme.xml names
        is listed as a Payload below. Name= is what ImageFile resolves against, and a missing one is not
        a build error but a bootstrapper that exits before drawing a window.
      -->
      <bal:WixStandardBootstrapperApplication
          Theme="rtfLicense"
          ThemeFile="$(sys.SOURCEFILEDIR)Assets\Theme.xml"
          LocalizationFile="$(sys.SOURCEFILEDIR)Assets\Theme.wxl"
          LogoFile="$(sys.SOURCEFILEDIR)Assets\Logo.png"
          LicenseFile="$(sys.SOURCEFILEDIR)License.rtf"
          SuppressOptionsUI="yes"
          ShowVersion="yes" />
      <!-- The wizard window's title-bar and taskbar icon. IconSourceFile above is only the icon of the .exe file. -->
      <Payload SourceFile="$(sys.SOURCEFILEDIR)..\InventoryApp\Assets\app.ico" Name="AppIcon.ico" />
      <Payload SourceFile="$(sys.SOURCEFILEDIR)Assets\LogoSide.png" Name="logoside.png" />
      <Payload SourceFile="$(sys.SOURCEFILEDIR)Assets\ButtonPrimary.png" Name="ButtonPrimary.png" />
      <Payload SourceFile="$(sys.SOURCEFILEDIR)Assets\ButtonPrimaryHover.png" Name="ButtonPrimaryHover.png" />
      <Payload SourceFile="$(sys.SOURCEFILEDIR)Assets\ButtonPrimaryPressed.png" Name="ButtonPrimaryPressed.png" />
      <Payload SourceFile="$(sys.SOURCEFILEDIR)Assets\ButtonDisabled.png" Name="ButtonDisabled.png" />
      <Payload SourceFile="$(sys.SOURCEFILEDIR)Assets\ButtonSecondary.png" Name="ButtonSecondary.png" />
      <Payload SourceFile="$(sys.SOURCEFILEDIR)Assets\ButtonSecondaryHover.png" Name="ButtonSecondaryHover.png" />
      <Payload SourceFile="$(sys.SOURCEFILEDIR)Assets\ButtonSecondaryPressed.png" Name="ButtonSecondaryPressed.png" />
    </BootstrapperApplication>

    <Chain>
      <!-- Visible="no": only the bundle appears in Add/Remove Programs, not a second entry for the .msi. -->
      <!-- MsiPath: the .msi the inner build of this project just made from Package.wxs. -->
      <MsiPackage Id="MainPackage" SourceFile="$(var.MsiPath)" Compressed="yes" Visible="no">
        <MsiProperty Name="DESKTOPSHORTCUT" Value="[DesktopShortcut]" />
        <MsiProperty Name="STARTMENUSHORTCUT" Value="[StartMenuShortcut]" />
        <MsiProperty Name="INSTALLFOLDER" Value="[InstallFolder]" />
      </MsiPackage>
    </Chain>

  </Bundle>
</Wix>
