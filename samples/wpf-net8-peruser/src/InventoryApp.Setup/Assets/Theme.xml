<?xml version="1.0" encoding="utf-8"?>
<!--
  The setup wizard, drawn by WiX's thmutil. Generated by custom-installer-wix.

  Control Names are a contract, not labels: wixstdba looks each one up by name to wire a button, bind
  the progress bar or fill in the failure text. Renaming InstallButton or OverallCalculatedProgressbar
  silently breaks what it drives. Change geometry, colours and text freely; keep the names.

  The panel is white on purpose. thmutil draws Checkbox, Progressbar and Editbox as plain Win32 controls
  whose text is always near-black, so a dark panel makes checkbox labels unreadable. The brand colour is
  carried by the accent sidebar image (on every page) and the button images instead (Assets\*.png, drawn from the app icon).

  Buttons are images because a thmutil Button without one is a grey Win32 slab. Each state is its own
  88x26 file: SourceX/SourceY index a theme-level image, so a sprite sheet fails to parse and the
  bootstrapper exits before drawing anything. Every graphic button needs ButtonImage, ButtonHoverImage
  and ButtonSelectedImage, or the theme fails to load.

  Negative X/Y are offsets from the right/bottom edge; negative Width/Height stop that far short of it.
-->
<Theme xmlns="http://wixtoolset.org/schemas/v4/thmutil">

  <!-- Font 0 also paints the window background. Every other font repeats that background so labels
       do not draw their own rectangle. Fonts 5-7 have no background: they sit on button images. -->
  <Font Id="0" Height="-12" Weight="500" Foreground="1F2328" Background="FFFFFF">Segoe UI</Font>
  <Font Id="1" Height="-26" Weight="600" Foreground="1F2328" Background="FFFFFF">Segoe UI</Font>
  <Font Id="2" Height="-18" Weight="500" Foreground="57606A" Background="FFFFFF">Segoe UI</Font>
  <Font Id="3" Height="-12" Weight="500" Foreground="1F2328" Background="FFFFFF">Segoe UI</Font>
  <Font Id="4" Height="-12" Weight="500" Foreground="57606A" Background="FFFFFF">Segoe UI</Font>
  <Font Id="5" Height="-12" Weight="600" Foreground="FFFFFF">Segoe UI</Font>
  <Font Id="6" Height="-12" Weight="500" Foreground="1F2328">Segoe UI</Font>
  <Font Id="7" Height="-12" Weight="600" Foreground="8C949F">Segoe UI</Font>

  <Window Width="600" Height="450" HexStyle="100a0000" FontId="0" Caption="#(loc.Caption)" IconFile="AppIcon.ico">

    <Page Name="Help">
      <ImageControl X="0" Y="0" Width="165" Height="450" ImageFile="logoside.png" />
      <Label X="196" Y="22" Width="-20" Height="36" FontId="1" DisablePrefix="yes">#(loc.Title)</Label>
      <Label X="196" Y="68" Width="-20" Height="26" FontId="2" DisablePrefix="yes">#(loc.HelpHeader)</Label>
      <Label X="196" Y="104" Width="-20" Height="-60" FontId="3" DisablePrefix="yes">#(loc.HelpText)</Label>
      <Button Name="HelpCloseButton" X="-20" Y="-18" Width="88" Height="26" TabStop="yes" FontId="6">
        <Text>#(loc.HelpCloseButton)</Text>
        <ButtonImage ImageFile="ButtonSecondary.png" />
        <ButtonHoverImage ImageFile="ButtonSecondaryHover.png" />
        <ButtonSelectedImage ImageFile="ButtonSecondaryPressed.png" />
        <ButtonFocusImage ImageFile="ButtonSecondaryHover.png" />
        <CloseWindowAction />
      </Button>
    </Page>

    <Page Name="Loading">
      <Label X="200" Y="70" Width="-20" Height="26" FontId="2" DisablePrefix="yes" Visible="no"
             Name="CheckingForUpdatesLabel" />
    </Page>

    <!--
      Install (the page wixstdba opens): licence, Options..., Install. "Options..." opens
      InstallOptions (folder, shortcuts); OK or Cancel come back. Install itself stays on this page:
      wixstdba hides only its own pages when the install starts, so an Install button on a page of
      ours would leave that page's controls on screen.
    -->
    <Page Name="Install">
      <ImageControl X="0" Y="0" Width="165" Height="450" ImageFile="logoside.png" />

      <Label X="196" Y="22" Width="-20" Height="36" FontId="1" DisablePrefix="yes">#(loc.Title)</Label>
      <Label X="196" Y="60" Width="-20" Height="34" FontId="4" DisablePrefix="yes">#(loc.InstallMessage)</Label>

      <Label X="196" Y="102" Width="-20" Height="16" FontId="4" DisablePrefix="yes">#(loc.LicenseHeader)</Label>
      <!-- Filled with License.rtf by wixstdba; the name is the contract. HexStyle 800000 = WS_BORDER. -->
      <Richedit Name="EulaRichedit" X="196" Y="122" Width="-20" Height="-92"
                TabStop="yes" FontId="0" HexStyle="800000" />
      <!-- wixstdba's own: it disables InstallButton until this is ticked (keyboard included). -->
      <Checkbox Name="EulaAcceptCheckbox" X="196" Y="-62" Width="-20" Height="20" TabStop="yes"
                FontId="3" HideWhenDisabled="yes">#(loc.InstallAcceptCheckbox)</Checkbox>

      <!-- Install location and shortcuts are chosen on InstallOptions only; this opens it. -->
      <Button Name="InstallOptionsButton" X="-212" Y="-18" Width="88" Height="26" TabStop="yes" FontId="6">
        <Text>#(loc.InstallOptionsButton)</Text>
        <ButtonImage ImageFile="ButtonSecondary.png" />
        <ButtonHoverImage ImageFile="ButtonSecondaryHover.png" />
        <ButtonSelectedImage ImageFile="ButtonSecondaryPressed.png" />
        <ButtonFocusImage ImageFile="ButtonSecondaryHover.png" />
        <ChangePageAction Page="InstallOptions" />
      </Button>
      <Label Name="InstallVersion" X="196" Y="-20" Width="100" Height="16" FontId="4"
             DisablePrefix="yes" VisibleCondition="WixStdBAShowVersion">#(loc.InstallVersion)</Label>

      <Button Name="InstallButton" X="-116" Y="-18" Width="88" Height="26" TabStop="yes" FontId="5" HideWhenDisabled="yes">
        <Text>#(loc.InstallInstallButton)</Text>
        <ButtonImage ImageFile="ButtonPrimary.png" />
        <ButtonHoverImage ImageFile="ButtonPrimaryHover.png" />
        <ButtonSelectedImage ImageFile="ButtonPrimaryPressed.png" />
        <ButtonFocusImage ImageFile="ButtonPrimaryHover.png" />
      </Button>
      <!--
        Until the licence is accepted wixstdba disables InstallButton, and HideWhenDisabled hides it, so
        this inert grey stand-in shows in its place. thmutil has no disabled-state image: a disabled image
        button would still look live. Two things keep it under the enabled button: it is declared AFTER
        InstallButton (Win32 stacks siblings in creation order, first on top, so declared first it takes
        the clicks), and HexStyle 4000000 = WS_CLIPSIBLINGS (without it, it still paints over the blue one).
      -->
      <Button Name="InstallBlockedButton" X="-116" Y="-18" Width="88" Height="26" TabStop="no" FontId="7" HexStyle="4000000">
        <Text>#(loc.InstallInstallButton)</Text>
        <ButtonImage ImageFile="ButtonDisabled.png" />
        <ButtonHoverImage ImageFile="ButtonDisabled.png" />
        <ButtonSelectedImage ImageFile="ButtonDisabled.png" />
      </Button>
      <Button Name="InstallCancelButton" X="-20" Y="-18" Width="88" Height="26" TabStop="yes" FontId="6">
        <Text>#(loc.InstallCancelButton)</Text>
        <ButtonImage ImageFile="ButtonSecondary.png" />
        <ButtonHoverImage ImageFile="ButtonSecondaryHover.png" />
        <ButtonSelectedImage ImageFile="ButtonSecondaryPressed.png" />
        <ButtonFocusImage ImageFile="ButtonSecondaryHover.png" />
        <CloseWindowAction />
      </Button>
    </Page>

    <!-- Folder and shortcuts. OK keeps the changes (the folder box is saved when the page is left);
         Cancel puts back the values the page opened with. -->
    <Page Name="InstallOptions">
      <ImageControl X="0" Y="0" Width="165" Height="450" ImageFile="logoside.png" />

      <Label X="196" Y="22" Width="-20" Height="36" FontId="1" DisablePrefix="yes">#(loc.Title)</Label>
      <Label X="196" Y="60" Width="-20" Height="34" FontId="4" DisablePrefix="yes">#(loc.InstallOptionsMessage)</Label>

      <!--
        The install folder. Bound by name to the InstallFolder variable in Bundle.wxs, which is passed to
        the .msi as INSTALLFOLDER. Locked once the product is installed (ProductInstalled): an upgrade
        goes where the app already is.
      -->
      <Label X="196" Y="102" Width="-20" Height="16" FontId="4" DisablePrefix="yes">#(loc.InstallFolderHeader)</Label>
      <Editbox Name="InstallFolder" X="196" Y="122" Width="-116" Height="24" TabStop="yes" FontId="3"
               HexStyle="800000" FileSystemAutoComplete="yes" EnableCondition="NOT ProductInstalled" />
      <Button Name="InstallFolderBrowseButton" X="-20" Y="121" Width="88" Height="26" TabStop="yes" FontId="6"
              EnableCondition="NOT ProductInstalled">
        <Text>#(loc.InstallFolderBrowseButton)</Text>
        <ButtonImage ImageFile="ButtonSecondary.png" />
        <ButtonHoverImage ImageFile="ButtonSecondaryHover.png" />
        <ButtonSelectedImage ImageFile="ButtonSecondaryPressed.png" />
        <ButtonFocusImage ImageFile="ButtonSecondaryHover.png" />
        <BrowseDirectoryAction VariableName="InstallFolder" />
      </Button>
      <Label X="196" Y="152" Width="-20" Height="34" FontId="4" DisablePrefix="yes">
        <Text>#(loc.InstallFolderHint)</Text>
        <Text Condition="ProductInstalled">#(loc.InstallFolderLockedHint)</Text>
      </Label>

      <Label X="196" Y="200" Width="-20" Height="16" FontId="4" DisablePrefix="yes">#(loc.ShortcutsHeader)</Label>
      <!-- Bound by name to the DesktopShortcut and StartMenuShortcut variables in Bundle.wxs, which are
           passed to the .msi. -->
      <Checkbox Name="DesktopShortcut" X="196" Y="220" Width="-20" Height="20" TabStop="yes" FontId="3">#(loc.DesktopShortcutCheckbox)</Checkbox>
      <Checkbox Name="StartMenuShortcut" X="196" Y="242" Width="-20" Height="20" TabStop="yes" FontId="3">#(loc.StartMenuShortcutCheckbox)</Checkbox>

      <Button Name="InstallOptionsOkButton" X="-116" Y="-18" Width="88" Height="26" TabStop="yes" FontId="5">
        <Text>#(loc.InstallOptionsOkButton)</Text>
        <ButtonImage ImageFile="ButtonPrimary.png" />
        <ButtonHoverImage ImageFile="ButtonPrimaryHover.png" />
        <ButtonSelectedImage ImageFile="ButtonPrimaryPressed.png" />
        <ButtonFocusImage ImageFile="ButtonPrimaryHover.png" />
        <ChangePageAction Page="Install" />
      </Button>
      <Button Name="InstallOptionsCancelButton" X="-20" Y="-18" Width="88" Height="26" TabStop="yes" FontId="6">
        <Text>#(loc.InstallCancelButton)</Text>
        <ButtonImage ImageFile="ButtonSecondary.png" />
        <ButtonHoverImage ImageFile="ButtonSecondaryHover.png" />
        <ButtonSelectedImage ImageFile="ButtonSecondaryPressed.png" />
        <ButtonFocusImage ImageFile="ButtonSecondaryHover.png" />
        <ChangePageAction Page="Install" Cancel="yes" />
      </Button>
    </Page>
    <Page Name="Progress">
      <ImageControl X="0" Y="0" Width="165" Height="450" ImageFile="logoside.png" />
      <Label X="196" Y="22" Width="-20" Height="36" FontId="1" DisablePrefix="yes">#(loc.Title)</Label>
      <Label X="196" Y="68" Width="-20" Height="26" FontId="2" DisablePrefix="yes">#(loc.ProgressHeader)</Label>
      <Label X="196" Y="124" Width="80" Height="18" FontId="4" DisablePrefix="yes">#(loc.ProgressLabel)</Label>
      <Label Name="OverallProgressPackageText" X="280" Y="124" Width="-20" Height="18" FontId="3"
             DisablePrefix="yes">#(loc.OverallProgressPackageText)</Label>
      <Progressbar Name="OverallCalculatedProgressbar" X="196" Y="150" Width="-20" Height="8" />
      <Button Name="ProgressCancelButton" X="-20" Y="-18" Width="88" Height="26" TabStop="yes" FontId="6">
        <Text>#(loc.ProgressCancelButton)</Text>
        <ButtonImage ImageFile="ButtonSecondary.png" />
        <ButtonHoverImage ImageFile="ButtonSecondaryHover.png" />
        <ButtonSelectedImage ImageFile="ButtonSecondaryPressed.png" />
        <ButtonFocusImage ImageFile="ButtonSecondaryHover.png" />
      </Button>
    </Page>

    <Page Name="Modify">
      <ImageControl X="0" Y="0" Width="165" Height="450" ImageFile="logoside.png" />
      <Label X="196" Y="22" Width="-20" Height="36" FontId="1" DisablePrefix="yes">#(loc.Title)</Label>
      <Label X="196" Y="68" Width="-20" Height="26" FontId="2" DisablePrefix="yes">#(loc.ModifyHeader)</Label>
      <Label X="196" Y="102" Width="-20" Height="56" FontId="3" DisablePrefix="yes">#(loc.ModifyMessage)</Label>
      <Button Name="RepairButton" X="-212" Y="-18" Width="88" Height="26" TabStop="yes" FontId="6" HideWhenDisabled="yes">
        <Text>#(loc.ModifyRepairButton)</Text>
        <ButtonImage ImageFile="ButtonSecondary.png" />
        <ButtonHoverImage ImageFile="ButtonSecondaryHover.png" />
        <ButtonSelectedImage ImageFile="ButtonSecondaryPressed.png" />
        <ButtonFocusImage ImageFile="ButtonSecondaryHover.png" />
      </Button>
      <Button Name="UninstallButton" X="-116" Y="-18" Width="88" Height="26" TabStop="yes" FontId="5">
        <Text>#(loc.ModifyUninstallButton)</Text>
        <ButtonImage ImageFile="ButtonPrimary.png" />
        <ButtonHoverImage ImageFile="ButtonPrimaryHover.png" />
        <ButtonSelectedImage ImageFile="ButtonPrimaryPressed.png" />
        <ButtonFocusImage ImageFile="ButtonPrimaryHover.png" />
      </Button>
      <Button Name="ModifyCancelButton" X="-20" Y="-18" Width="88" Height="26" TabStop="yes" FontId="6">
        <Text>#(loc.ModifyCancelButton)</Text>
        <ButtonImage ImageFile="ButtonSecondary.png" />
        <ButtonHoverImage ImageFile="ButtonSecondaryHover.png" />
        <ButtonSelectedImage ImageFile="ButtonSecondaryPressed.png" />
        <ButtonFocusImage ImageFile="ButtonSecondaryHover.png" />
        <CloseWindowAction />
      </Button>
    </Page>

    <Page Name="Success">
      <ImageControl X="0" Y="0" Width="165" Height="450" ImageFile="logoside.png" />
      <Label X="196" Y="22" Width="-20" Height="36" FontId="1" DisablePrefix="yes">#(loc.Title)</Label>
      <Label X="196" Y="68" Width="-20" Height="26" FontId="2" DisablePrefix="yes">
        <Text>#(loc.SuccessHeader)</Text>
        <Text Condition="WixBundleAction = 2">#(loc.SuccessLayoutHeader)</Text>
        <Text Condition="WixBundleAction = 3">#(loc.SuccessUninstallHeader)</Text>
        <Text Condition="WixBundleAction = 4">#(loc.SuccessUninstallHeader)</Text>
        <Text Condition="WixBundleAction = 5">#(loc.SuccessCacheHeader)</Text>
        <Text Condition="WixBundleAction = 6">#(loc.SuccessInstallHeader)</Text>
        <Text Condition="WixBundleAction = 7">#(loc.SuccessModifyHeader)</Text>
        <Text Condition="WixBundleAction = 8">#(loc.SuccessRepairHeader)</Text>
      </Label>
      <Label X="196" Y="-106" Width="-20" Height="36" FontId="4" DisablePrefix="yes"
             VisibleCondition="WixStdBARestartRequired">#(loc.SuccessRestartText)</Label>
      <Button Name="SuccessRestartButton" X="-212" Y="-18" Width="88" Height="26" TabStop="yes" FontId="6" HideWhenDisabled="yes">
        <Text>#(loc.SuccessRestartButton)</Text>
        <ButtonImage ImageFile="ButtonSecondary.png" />
        <ButtonHoverImage ImageFile="ButtonSecondaryHover.png" />
        <ButtonSelectedImage ImageFile="ButtonSecondaryPressed.png" />
        <ButtonFocusImage ImageFile="ButtonSecondaryHover.png" />
      </Button>
      <Button Name="LaunchButton" X="-116" Y="-18" Width="88" Height="26" TabStop="yes" FontId="5" HideWhenDisabled="yes">
        <Text>#(loc.SuccessLaunchButton)</Text>
        <ButtonImage ImageFile="ButtonPrimary.png" />
        <ButtonHoverImage ImageFile="ButtonPrimaryHover.png" />
        <ButtonSelectedImage ImageFile="ButtonPrimaryPressed.png" />
        <ButtonFocusImage ImageFile="ButtonPrimaryHover.png" />
      </Button>
      <Button Name="SuccessCloseButton" X="-20" Y="-18" Width="88" Height="26" TabStop="yes" FontId="6">
        <Text>#(loc.SuccessCloseButton)</Text>
        <ButtonImage ImageFile="ButtonSecondary.png" />
        <ButtonHoverImage ImageFile="ButtonSecondaryHover.png" />
        <ButtonSelectedImage ImageFile="ButtonSecondaryPressed.png" />
        <ButtonFocusImage ImageFile="ButtonSecondaryHover.png" />
        <CloseWindowAction />
      </Button>
    </Page>

    <Page Name="Failure">
      <ImageControl X="0" Y="0" Width="165" Height="450" ImageFile="logoside.png" />
      <Label X="196" Y="22" Width="-20" Height="36" FontId="1" DisablePrefix="yes">#(loc.Title)</Label>
      <Label X="196" Y="68" Width="-20" Height="26" FontId="2" DisablePrefix="yes">
        <Text>#(loc.FailureHeader)</Text>
        <Text Condition="WixBundleAction = 3">#(loc.FailureUninstallHeader)</Text>
        <Text Condition="WixBundleAction = 4">#(loc.FailureUninstallHeader)</Text>
        <Text Condition="WixBundleAction = 7">#(loc.FailureModifyHeader)</Text>
        <Text Condition="WixBundleAction = 8">#(loc.FailureRepairHeader)</Text>
      </Label>
      <Hypertext Name="FailureLogFileLink" X="196" Y="106" Width="-20" Height="56" FontId="4"
                 TabStop="yes" HideWhenDisabled="yes">#(loc.FailureHyperlinkLogText)</Hypertext>
      <Hypertext Name="FailureMessageText" X="196" Y="172" Width="-20" Height="80" FontId="3"
                 TabStop="yes" HideWhenDisabled="yes" />
      <Label X="196" Y="-106" Width="-20" Height="36" FontId="4" DisablePrefix="yes"
             VisibleCondition="WixStdBARestartRequired">#(loc.FailureRestartText)</Label>
      <Button Name="FailureRestartButton" X="-116" Y="-18" Width="88" Height="26" TabStop="yes" FontId="6" HideWhenDisabled="yes">
        <Text>#(loc.FailureRestartButton)</Text>
        <ButtonImage ImageFile="ButtonSecondary.png" />
        <ButtonHoverImage ImageFile="ButtonSecondaryHover.png" />
        <ButtonSelectedImage ImageFile="ButtonSecondaryPressed.png" />
        <ButtonFocusImage ImageFile="ButtonSecondaryHover.png" />
      </Button>
      <Button Name="FailureCloseButton" X="-20" Y="-18" Width="88" Height="26" TabStop="yes" FontId="6">
        <Text>#(loc.FailureCloseButton)</Text>
        <ButtonImage ImageFile="ButtonSecondary.png" />
        <ButtonHoverImage ImageFile="ButtonSecondaryHover.png" />
        <ButtonSelectedImage ImageFile="ButtonSecondaryPressed.png" />
        <ButtonFocusImage ImageFile="ButtonSecondaryHover.png" />
        <CloseWindowAction />
      </Button>
    </Page>

  </Window>
</Theme>
