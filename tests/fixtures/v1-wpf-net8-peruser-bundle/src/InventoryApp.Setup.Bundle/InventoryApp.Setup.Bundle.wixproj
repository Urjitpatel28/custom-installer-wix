<Project Sdk="WixToolset.Sdk/5.0.2">

  <!--
    Builds ContosoInventorySetup.exe: the branded setup wizard, with ContosoInventory.msi embedded.
    Generated by custom-installer-wix.

        msbuild InventoryApp.Setup.Bundle\InventoryApp.Setup.Bundle.wixproj -restore -p:Configuration=Release

    Building this builds InventoryApp.Setup (and through it the app) first, and takes its version from the
    .msi. It lives in its own folder, not beside the .msi project, so the two do not share obj\ or
    each other's *.wxs.
  -->
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <OutputName>ContosoInventorySetup</OutputName>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU' or '$(Platform)' == 'Any CPU'">x64</Platform>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Bundle.wxs" />
    <None Include="Assets\**" />
    <PackageReference Include="WixToolset.BootstrapperApplications.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Gives Bundle.wxs $(var.InventoryApp.Setup.TargetPath): the .msi this build just produced. -->
    <ProjectReference Include="..\InventoryApp.Setup\InventoryApp.Setup.wixproj" />
  </ItemGroup>

</Project>
