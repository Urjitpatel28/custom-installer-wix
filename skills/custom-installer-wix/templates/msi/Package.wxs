<?xml version="1.0" encoding="utf-8"?>
<!--
  {{PRODUCT_NAME}} installer. Generated by custom-installer-wix; edit freely.

  NEVER change UpgradeCode. It is how Windows Installer recognises a new version of this product as an
  upgrade of the old one. A new UpgradeCode installs side by side with every copy already out there.

  PayloadDir and ProductVersion come from {{SETUP_NAME}}.wixproj.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="{{PRODUCT_NAME}}"
           Manufacturer="{{MANUFACTURER}}"
           Version="$(ProductVersion)"
           UpgradeCode="{{UPGRADE_CODE}}"
           Scope="{{SCOPE}}"
           Compressed="yes">

    <!-- A new version replaces the old one in place; installing an older one over it is refused. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <!--
      Write every file, whatever version is already installed.

      The default reinstall mode only overwrites a file that is older or missing. A file whose version
      went *down* (an assembly whose AssemblyVersion was reset, a dependency downgraded) is dropped from
      the install plan, and the major upgrade still removes the old copy, so the file ends up missing and
      the app fails to start. "amus" takes file versions out of the decision.

      A SetProperty rather than a Property because a bootstrapper passes REINSTALLMODE on the msiexec
      command line, which overrides the Property table; this runs after that and before costing.
    -->
    <SetProperty Id="REINSTALLMODE" Value="amus" Before="CostInitialize" Sequence="both" />

    <MediaTemplate EmbedCab="yes" />
{{#HAS_ICON}}

    <!-- The application icon, for Add/Remove Programs and the shortcuts. Windows Installer cannot read
         an icon out of a file it has not installed yet, so it is carried separately. -->
    <Icon Id="AppIcon.ico" SourceFile="$(sys.SOURCEFILEDIR){{ICON_REL}}" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
{{/HAS_ICON}}
{{#HAS_URL}}
    <Property Id="ARPURLINFOABOUT" Value="{{URL}}" />
{{/HAS_URL}}

    <!--
      Desktop shortcut: DESKTOPSHORTCUT=1 or 0 on the command line (the bundle passes it from its
      checkbox). When nothing is passed, the previous install's choice is reused, so an unattended
      upgrade does not put back a shortcut the user deleted or remove one they asked for. A first
      install with nothing passed gets the default.
    -->
    <Property Id="DESKTOPSHORTCUT" Secure="yes" />
    <Property Id="DESKTOPSHORTCUT_REMEMBERED" Secure="yes">
      <RegistrySearch Id="RememberDesktopShortcut" Root="{{REG_ROOT}}" Key="{{REG_KEY}}"
                      Name="DesktopShortcut" Type="raw"{{#PER_MACHINE}} Bitness="always64"{{/PER_MACHINE}} />
    </Property>
    <SetProperty Id="DESKTOPSHORTCUT" Value="[DESKTOPSHORTCUT_REMEMBERED]" After="AppSearch"
                 Condition="DESKTOPSHORTCUT_REMEMBERED AND NOT DESKTOPSHORTCUT" />
    <SetProperty Id="DESKTOPSHORTCUT" Action="SetDesktopShortcutDefault" Value="{{DESKTOP_DEFAULT}}"
                 After="SetDESKTOPSHORTCUT" Condition="NOT DESKTOPSHORTCUT" />

    <!-- Start menu shortcut: STARTMENUSHORTCUT=1 or 0, remembered the same way, on by default. Recorded as
         "StartMenu": "StartMenuShortcut" is the shortcut component's own key path. -->
    <Property Id="STARTMENUSHORTCUT" Secure="yes" />
    <Property Id="STARTMENUSHORTCUT_REMEMBERED" Secure="yes">
      <RegistrySearch Id="RememberStartMenuShortcut" Root="{{REG_ROOT}}" Key="{{REG_KEY}}"
                      Name="StartMenu" Type="raw"{{#PER_MACHINE}} Bitness="always64"{{/PER_MACHINE}} />
    </Property>
    <SetProperty Id="STARTMENUSHORTCUT" Value="[STARTMENUSHORTCUT_REMEMBERED]" After="AppSearch"
                 Condition="STARTMENUSHORTCUT_REMEMBERED AND NOT STARTMENUSHORTCUT" />
    <SetProperty Id="STARTMENUSHORTCUT" Action="SetStartMenuShortcutDefault" Value="1"
                 After="SetSTARTMENUSHORTCUT" Condition="NOT STARTMENUSHORTCUT" />

    <!--
      Install folder: INSTALLFOLDER=<path> on the command line (the bundle passes the wizard's folder
      field). When nothing is passed, an upgrade goes to the folder the installed version recorded,
      not back to the default.
    -->
    <Property Id="INSTALLFOLDER_REMEMBERED" Secure="yes">
      <RegistrySearch Id="RememberInstallFolder" Root="{{REG_ROOT}}" Key="{{REG_KEY}}"
                      Name="InstallFolder" Type="raw"{{#PER_MACHINE}} Bitness="always64"{{/PER_MACHINE}} />
    </Property>
    <SetProperty Id="INSTALLFOLDER" Action="SetInstallFolderRemembered" Value="[INSTALLFOLDER_REMEMBERED]"
                 After="AppSearch" Condition="INSTALLFOLDER_REMEMBERED AND NOT INSTALLFOLDER" />

{{#PER_MACHINE}}
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="{{INSTALL_DIR_NAME}}" />
    </StandardDirectory>
{{/PER_MACHINE}}
{{#PER_USER}}
    <!-- %LOCALAPPDATA%\Programs\<App>: the per-user install convention. Deliberately not
         %LOCALAPPDATA%\<App>, which is where apps keep their data and must survive an uninstall. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="{{INSTALL_DIR_NAME}}" />
      </Directory>
    </StandardDirectory>
{{/PER_USER}}

    <!-- Harvested rather than listed, so a new dependency of the app never needs an edit here. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PayloadDir)**">
        <Exclude Files="$(PayloadDir)**\*.pdb" />
      </Files>
    </ComponentGroup>

    <!-- Records the user's choices. Unconditional, because a component that is not installed writes
         nothing - so "no desktop shortcut" has to be written by something that always is. -->
    <Component Id="InstallPreferences" Directory="INSTALLFOLDER">
      <RegistryValue Root="{{REG_ROOT}}" Key="{{REG_KEY}}" Name="DesktopShortcut" Type="string"
                     Value="[DESKTOPSHORTCUT]" KeyPath="yes" />
      <RegistryValue Root="{{REG_ROOT}}" Key="{{REG_KEY}}" Name="StartMenu" Type="string"
                     Value="[STARTMENUSHORTCUT]" />
      <RegistryValue Root="{{REG_ROOT}}" Key="{{REG_KEY}}" Name="InstallFolder" Type="string"
                     Value="[INSTALLFOLDER]" />
{{#PER_USER}}
      <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
{{/PER_USER}}
    </Component>

    <!-- Shortcut components use an HKCU key path even in a per-machine package: Windows Installer's
         validation (ICE38, ICE43, ICE57) requires it for a component holding a non-advertised shortcut. -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Condition='STARTMENUSHORTCUT = "1"'>
        <Shortcut Id="StartMenuShortcut" Name="{{PRODUCT_NAME}}" Description="{{DESCRIPTION}}"
                  Target="[INSTALLFOLDER]{{EXE_NAME}}" WorkingDirectory="INSTALLFOLDER"{{#HAS_ICON}} Icon="AppIcon.ico"{{/HAS_ICON}} />
        <RegistryValue Root="HKCU" Key="{{REG_KEY}}" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Condition='DESKTOPSHORTCUT = "1"'>
        <Shortcut Id="DesktopShortcut" Name="{{PRODUCT_NAME}}" Description="{{DESCRIPTION}}"
                  Target="[INSTALLFOLDER]{{EXE_NAME}}" WorkingDirectory="INSTALLFOLDER"{{#HAS_ICON}} Icon="AppIcon.ico"{{/HAS_ICON}} />
        <RegistryValue Root="HKCU" Key="{{REG_KEY}}" Name="DesktopShortcutInstalled" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="InstallPreferences" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- Welcome, licence, install folder, install. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
{{#HAS_LICENSE}}
    <WixVariable Id="WixUILicenseRtf" Value="$(sys.SOURCEFILEDIR)License.rtf" />
{{/HAS_LICENSE}}
{{^HAS_LICENSE}}
    <!-- No licence was supplied, so the licence page is skipped rather than showing WiX's sample text.
         Order="2" runs after the stock Order="1" events, and the last NewDialog wins. -->
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
    </UI>
{{/HAS_LICENSE}}
{{#HAS_ICON}}
    <WixVariable Id="WixUIBannerBmp" Value="$(sys.SOURCEFILEDIR)Assets\Banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(sys.SOURCEFILEDIR)Assets\Dialog.bmp" />
{{/HAS_ICON}}

  </Package>
</Wix>
