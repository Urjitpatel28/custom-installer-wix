<Project Sdk="WixToolset.Sdk/5.0.2">

  <!--
    Builds ContosoInventory.msi for InventoryApp. Generated by custom-installer-wix.

    Build it on its own (it is in the solution, but no solution configuration builds it):

        msbuild InventoryApp.Setup\InventoryApp.Setup.wixproj -restore -p:Configuration=Release

    It builds the app itself first, so there is nothing to build beforehand. -p:ProductVersion=1.2.3
    overrides the version, which otherwise comes from the built assembly. Windows Installer compares
    only the first three parts, so bump one of those for every release or the upgrade will not run.

    Opening it in Visual Studio needs the FireGiant HeatWave extension; without it the project is
    listed as "incompatible". WiX is pinned to v5: v6 and later refuse to build until the Open Source
    Maintenance Fee EULA is accepted, which an unattended build cannot do.
  -->
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>ContosoInventory</OutputName>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU' or '$(Platform)' == 'Any CPU'">x64</Platform>

    <!-- The SDK compiles every *.wxs under this folder by default; listing them keeps that explicit. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <AppProject>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\InventoryApp\InventoryApp.csproj'))</AppProject>
    <!-- dotnet publish output. Cleared on every build so a file the app stopped shipping is not
         harvested from a previous publish. -->
    <PayloadDir>$(MSBuildThisFileDirectory)obj\payload\$(Configuration)\</PayloadDir>

    <!-- A per-user package installs files under the user profile. These ICEs require an HKCU key path
         on every such component, which harvested <Files> cannot have; the install is still correct. -->
    <SuppressIces>ICE38;ICE64;ICE91</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Package.wxs" />
    <None Include="Assets\**" />
    <None Include="License.rtf" />
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>

  <!--
    Produces the files the package harvests. Runs before CoreCompile because that is where WiX reads
    DefineConstants; anything earlier in the build would be too soon to know the payload folder.
    -p:SkipAppBuild=true packages whatever is already in the payload folder.
  -->
  <Target Name="BuildAppPayload" BeforeTargets="CoreCompile">
    <!-- Self-contained: the .NET runtime ships inside the install folder, so the target machine needs
         nothing installed first. -->
    <RemoveDir Directories="$(PayloadDir)" Condition="'$(SkipAppBuild)' != 'true'" />
    <Exec Condition="'$(SkipAppBuild)' != 'true'"
          Command="dotnet publish &quot;$(AppProject)&quot; -c $(Configuration) -r win-x64 --self-contained true -p:PublishSingleFile=false -o &quot;$(PayloadDir.TrimEnd('\'))&quot; -nologo" />
    <PropertyGroup>
      <_AppAssembly>$(PayloadDir)InventoryApp.dll</_AppAssembly>
    </PropertyGroup>

    <Error Condition="!Exists('$(PayloadDir)InventoryApp.exe')" Text="InventoryApp.exe is not in $(PayloadDir). The app build did not produce it." />

    <GetAssemblyIdentity AssemblyFiles="$(_AppAssembly)" Condition="'$(ProductVersion)' == ''">
      <Output TaskParameter="Assemblies" ItemName="_AppIdentity" />
    </GetAssemblyIdentity>
    <PropertyGroup>
      <ProductVersion Condition="'$(ProductVersion)' == ''">@(_AppIdentity->'%(Version)')</ProductVersion>
      <DefineConstants>$(DefineConstants);PayloadDir=$(PayloadDir);ProductVersion=$(ProductVersion)</DefineConstants>
    </PropertyGroup>

    <!-- WiX skips recompiling when no source file changed, and neither a new version nor a file added
         to the payload changes one - the old .msi would be shipped under the new number. This stamp
         changes whenever either does, and is made an input of the compile. -->
    <ItemGroup>
      <_PayloadFile Include="$(PayloadDir)**" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)payload.stamp" Lines="$(ProductVersion);@(_PayloadFile)"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <PropertyGroup>
      <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildProjectDirectory)\$(IntermediateOutputPath)payload.stamp</MSBuildAllProjects>
    </PropertyGroup>
    <Message Importance="high" Text="Packaging $(PayloadDir) as version $(ProductVersion)" />
  </Target>

</Project>
