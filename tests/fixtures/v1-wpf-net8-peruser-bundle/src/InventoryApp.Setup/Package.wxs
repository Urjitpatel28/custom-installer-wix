<?xml version="1.0" encoding="utf-8"?>
<!--
  Contoso Inventory installer. Generated by custom-installer-wix; edit freely.

  NEVER change UpgradeCode. It is how Windows Installer recognises a new version of this product as an
  upgrade of the old one. A new UpgradeCode installs side by side with every copy already out there.

  PayloadDir and ProductVersion come from InventoryApp.Setup.wixproj.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="Contoso Inventory"
           Manufacturer="Contoso Ltd"
           Version="$(ProductVersion)"
           UpgradeCode="86D061BE-0896-4CC6-9A0A-D0130B29BCB1"
           Scope="perUser"
           Compressed="yes">

    <!-- A new version replaces the old one in place; installing an older one over it is refused. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <!--
      Write every file, whatever version is already installed.

      The default reinstall mode only overwrites a file that is older or missing. A file whose version
      went *down* (an assembly whose AssemblyVersion was reset, a dependency downgraded) is dropped from
      the install plan, and the major upgrade still removes the old copy, so the file ends up missing and
      the app fails to start. "amus" takes file versions out of the decision.

      A SetProperty rather than a Property because a bootstrapper passes REINSTALLMODE on the msiexec
      command line, which overrides the Property table; this runs after that and before costing.
    -->
    <SetProperty Id="REINSTALLMODE" Value="amus" Before="CostInitialize" Sequence="both" />

    <MediaTemplate EmbedCab="yes" />

    <!-- The application icon, for Add/Remove Programs and the shortcuts. Windows Installer cannot read
         an icon out of a file it has not installed yet, so it is carried separately. -->
    <Icon Id="AppIcon.ico" SourceFile="$(sys.SOURCEFILEDIR)..\InventoryApp\Assets\app.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://contoso.example" />

    <!--
      Desktop shortcut: DESKTOPSHORTCUT=1 or 0 on the command line (the bundle passes it from its
      checkbox). When nothing is passed, the previous install's choice is reused, so an unattended
      upgrade does not put back a shortcut the user deleted or remove one they asked for. A first
      install with nothing passed gets the default.
    -->
    <Property Id="DESKTOPSHORTCUT" Secure="yes" />
    <Property Id="DESKTOPSHORTCUT_REMEMBERED" Secure="yes">
      <RegistrySearch Id="RememberDesktopShortcut" Root="HKCU" Key="Software\Contoso Ltd\Contoso Inventory"
                      Name="DesktopShortcut" Type="raw" />
    </Property>
    <SetProperty Id="DESKTOPSHORTCUT" Value="[DESKTOPSHORTCUT_REMEMBERED]" After="AppSearch"
                 Condition="DESKTOPSHORTCUT_REMEMBERED AND NOT DESKTOPSHORTCUT" />
    <SetProperty Id="DESKTOPSHORTCUT" Action="SetDesktopShortcutDefault" Value="1"
                 After="SetDESKTOPSHORTCUT" Condition="NOT DESKTOPSHORTCUT" />

    <!-- %LOCALAPPDATA%\Programs\<App>: the per-user install convention. Deliberately not
         %LOCALAPPDATA%\<App>, which is where apps keep their data and must survive an uninstall. -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Contoso Inventory" />
      </Directory>
    </StandardDirectory>

    <!-- Harvested rather than listed, so a new dependency of the app never needs an edit here. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PayloadDir)**">
        <Exclude Files="$(PayloadDir)**\*.pdb" />
      </Files>
    </ComponentGroup>

    <!-- Records the shortcut choice. Unconditional, because a component that is not installed writes
         nothing - so "no desktop shortcut" has to be written by something that always is. -->
    <Component Id="InstallPreferences" Directory="INSTALLFOLDER">
      <RegistryValue Root="HKCU" Key="Software\Contoso Ltd\Contoso Inventory" Name="DesktopShortcut" Type="string"
                     Value="[DESKTOPSHORTCUT]" KeyPath="yes" />
      <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
    </Component>

    <!-- Shortcut components use an HKCU key path even in a per-machine package: Windows Installer's
         validation (ICE38, ICE43, ICE57) requires it for a component holding a non-advertised shortcut. -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="StartMenuShortcut" Name="Contoso Inventory" Description="Track stock across Contoso warehouses"
                  Target="[INSTALLFOLDER]InventoryApp.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon.ico" />
        <RegistryValue Root="HKCU" Key="Software\Contoso Ltd\Contoso Inventory" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Condition='DESKTOPSHORTCUT = "1"'>
        <Shortcut Id="DesktopShortcut" Name="Contoso Inventory" Description="Track stock across Contoso warehouses"
                  Target="[INSTALLFOLDER]InventoryApp.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon.ico" />
        <RegistryValue Root="HKCU" Key="Software\Contoso Ltd\Contoso Inventory" Name="DesktopShortcutInstalled" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="InstallPreferences" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- Welcome, licence, install folder, install. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(sys.SOURCEFILEDIR)License.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="$(sys.SOURCEFILEDIR)Assets\Banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(sys.SOURCEFILEDIR)Assets\Dialog.bmp" />

  </Package>
</Wix>
