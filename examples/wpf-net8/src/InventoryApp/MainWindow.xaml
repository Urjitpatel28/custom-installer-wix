<Window x:Class="InventoryApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contoso Inventory" Height="320" Width="480" Icon="Assets/app.ico">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" Text="Stock" />
        <DataGrid x:Name="StockGrid" AutoGenerateColumns="True" IsReadOnly="True" />
    </DockPanel>
</Window>
