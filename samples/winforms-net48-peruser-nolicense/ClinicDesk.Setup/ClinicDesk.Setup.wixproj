<Project Sdk="WixToolset.Sdk/6.0.2">

  <!--
    Builds ClinicDeskSetup.exe, the setup for ClinicDesk. Generated by custom-installer-wix.

    Build it on its own (it is in the solution, but no solution configuration builds it): right-click >
    Build in Visual Studio, or

        msbuild ClinicDesk.Setup\ClinicDesk.Setup.wixproj -restore -p:Configuration=Release

    The setup lands in bin\<Configuration>\ and is the only file there. It builds the app itself first,
    always in Release (-p:AppConfiguration=Debug packages a Debug build instead).

    One project, two WiX builds: this project builds the .msi (Package.wxs) by calling itself with
    CiwInner=true, into obj\msi\, then the setup .exe (Bundle.wxs) with that .msi embedded. The .msi is
    not a separate deliverable. For IT deployment take it from obj\msi\bin\<Configuration>\en-us\, or run
    "wix burn extract ClinicDeskSetup.exe -o <folder>" on a shipped .exe (the .msi is the file named a0).

    The version is the app's file version (<Version> in the app project); -p:ProductVersion=1.2.3
    overrides it. Windows Installer compares only the first three parts, so bump one of those for every
    release or the upgrade will not run. The build logic is in CustomInstallerWix.targets.

    Works with the MSBuild of Visual Studio 2022 and 2026 and with the .NET SDK. Opening it in Visual
    Studio needs the FireGiant HeatWave extension; without it the project is listed as "incompatible".
    WiX is pinned to v6: v7 and later require accepting the Open Source Maintenance Fee EULA.
  -->
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <OutputName>ClinicDeskSetup</OutputName>
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU' or '$(Platform)' == 'Any CPU'">x64</Platform>
    <!-- Only the setup .exe in the output folder: no .wixpdb, no platform sub-folder. -->
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <SuppressPdbOutput>true</SuppressPdbOutput>

    <!-- The SDK compiles every *.wxs under this folder by default; listing them keeps that explicit. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <!-- The generator version that wrote this project. New-WixSetup.ps1 -Refresh updates older ones. -->
    <CustomInstallerWixVersion>5</CustomInstallerWixVersion>

    <AppProject>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\ClinicDesk\ClinicDesk.csproj'))</AppProject>
    <AppExeName>ClinicDesk.exe</AppExeName>
    <AppAssemblyName>ClinicDesk</AppAssemblyName>
    <AppConfiguration Condition="'$(AppConfiguration)' == ''">Release</AppConfiguration>
    <AppSelfContained>false</AppSelfContained>
    <AppPlatform>AnyCPU</AppPlatform>

    <!--
      Code signing, off until a certificate is named. With SignCertificateThumbprint set (a code-signing
      certificate in the Windows certificate store), the build signs the .msi, the setup engine and the
      setup .exe with signtool from the Windows SDK, timestamped. SignCommand replaces the whole signtool
      command (Azure Trusted Signing, a hardware token, ...); the file to sign is appended, in quotes.
      Pass them on the command line to keep them out of source control:
        msbuild ... -p:SignCertificateThumbprint=0123abcd...
    -->
    <SignCertificateThumbprint Condition="'$(SignCertificateThumbprint)' == ''"></SignCertificateThumbprint>
  </PropertyGroup>

  <!-- The inner build: the .msi, kept under obj\ so it never reaches the output folder. -->
  <PropertyGroup Condition="'$(CiwInner)' == 'true'">
    <OutputType>Package</OutputType>
    <OutputName>ClinicDesk</OutputName>
    <OutputPath>obj\msi\bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\msi\obj\$(Configuration)\</IntermediateOutputPath>
    <!-- A per-user package installs files under the user profile. These ICEs require an HKCU key path
         on every such component, which harvested <Files> cannot have; the install is still correct. -->
    <SuppressIces>ICE38;ICE64;ICE91</SuppressIces>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Bundle.wxs" Condition="'$(CiwInner)' != 'true'" />
    <Compile Include="Package.wxs" Condition="'$(CiwInner)' == 'true'" />
    <None Include="Package.wxs" Condition="'$(CiwInner)' != 'true'" />
    <None Include="CustomInstallerWix.targets" />
    <None Include="Assets\**" />
    <None Include="License.rtf" />
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.BootstrapperApplications.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" />
  </ItemGroup>

  <Import Project="CustomInstallerWix.targets" />

</Project>
