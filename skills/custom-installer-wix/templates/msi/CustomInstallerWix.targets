<Project>

  <!--
    The build logic of the Setup project. Generated by custom-installer-wix: the same file in every
    generated project, and replaced wholesale by New-WixSetup.ps1 -Refresh. Put project-specific
    changes in the .wixproj, not here.

    The project builds twice:
      outer (the normal build)   BuildSetupMsi runs the inner build, then Bundle.wxs is compiled into
                                 the setup .exe with the .msi embedded (MsiPath)
      inner (CiwInner=true)      BuildAppPayload builds the app, then Package.wxs is compiled into the .msi

    Inputs (set in the .wixproj):
      AppProject             the app's project file
      AppConfiguration       the configuration the app is built in (Release unless overridden)
      AppExeName             the exe the package must contain
      AppAssemblyName        the app's assembly name
      AppSelfContained       true: dotnet publish, self-contained (.NET 5+); false: the app's build output
      AppRuntimeIdentifier   with AppSelfContained, the runtime to publish for (win-x64, win-x86)
      AppPlatform            without AppSelfContained, the platform to build the app for
      AppTargetFramework     optional: which of a multi-targeted app's frameworks to package
      AppPublishArguments    optional: more dotnet publish arguments (WinUI: Windows App SDK self-contained)
      SignCertificateThumbprint / SignCommand / SignToolPath / SignTimestampUrl
                             optional: code signing, see "Signing" below

    Outputs (to Package.wxs and Bundle.wxs, through DefineConstants):
      PayloadDir             the folder that is harvested into the package
      ProductVersion         -p:ProductVersion=x.y.z, else the app's file version, else its assembly version
      MsiPath                the .msi the inner build produced (outer build only)

    -p:SkipAppBuild=true packages whatever is already in the payload folder.
  -->

  <PropertyGroup Condition="'$(AppSelfContained)' == 'true'">
    <!-- Cleared on every build so a file the app stopped shipping is not harvested from a previous publish. -->
    <PayloadDir>$(MSBuildProjectDirectory)\obj\payload\$(AppConfiguration)\</PayloadDir>
  </PropertyGroup>

  <!-- How the app is built. TargetFramework is passed only when set: an empty global property would
       blank out a single-target project's own TargetFramework. -->
  <PropertyGroup>
    <_AppPublishFramework Condition="'$(AppTargetFramework)' != ''">-f $(AppTargetFramework)</_AppPublishFramework>
    <_AppBuildProperties>Configuration=$(AppConfiguration);Platform=$(AppPlatform)</_AppBuildProperties>
    <_AppBuildProperties Condition="'$(AppTargetFramework)' != ''">$(_AppBuildProperties);TargetFramework=$(AppTargetFramework)</_AppBuildProperties>
  </PropertyGroup>

  <!--
    Outer build: the .msi first. Global properties (ProductVersion, SkipAppBuild, AppConfiguration from
    the command line) flow into the inner build by themselves.
  -->
  <Target Name="BuildSetupMsi" BeforeTargets="CoreCompile" Condition="'$(CiwInner)' != 'true'">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Build" Properties="CiwInner=true;Configuration=$(Configuration);Platform=$(Platform)">
      <Output TaskParameter="TargetOutputs" ItemName="_SetupMsi" />
    </MSBuild>
    <PropertyGroup>
      <MsiPath>@(_SetupMsi->'%(FullPath)')</MsiPath>
      <DefineConstants>$(DefineConstants);MsiPath=$(MsiPath)</DefineConstants>
    </PropertyGroup>
    <!-- As with payload.stamp below: WiX would not rebuild the .exe for a new .msi on its own. -->
    <WriteLinesToFile File="$(IntermediateOutputPath)bundle.stamp" Lines="$(MsiPath);%(_SetupMsi.ModifiedTime)"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <PropertyGroup>
      <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildProjectDirectory)\$(IntermediateOutputPath)bundle.stamp</MSBuildAllProjects>
    </PropertyGroup>
  </Target>

  <!--
    Reads the numeric file version (FileMajorPart...FilePrivatePart) of a built file. Those come from
    the app's <Version>/<FileVersion> (or [AssemblyFileVersion]), which is what teams bump per release;
    AssemblyVersion is often pinned for binding compatibility and is only the fallback. The numeric
    parts, not the FileVersion string, because that string may carry a "+commit" suffix.
    RoslynCodeTaskFactory ships with MSBuild 16+ (Visual Studio 2019, 2022, 2026) and the .NET SDK.
  -->
  <UsingTask TaskName="CiwGetFileVersion" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <File ParameterType="System.String" Required="true" />
      <Version ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Diagnostics" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var info = FileVersionInfo.GetVersionInfo(File);
        if (info.FileMajorPart + info.FileMinorPart + info.FileBuildPart + info.FilePrivatePart > 0)
            Version = info.FileMajorPart + "." + info.FileMinorPart + "." + info.FileBuildPart + "." + info.FilePrivatePart;
      ]]></Code>
    </Task>
  </UsingTask>

  <!--
    Produces the files the package harvests. Runs before CoreCompile because that is where WiX reads
    DefineConstants; anything earlier in the build would be too soon to know the payload folder.
  -->
  <Target Name="BuildAppPayload" BeforeTargets="CoreCompile" Condition="'$(CiwInner)' == 'true'">
    <!-- Self-contained: the .NET runtime ships inside the install folder, so the target machine needs
         nothing installed first. -->
    <RemoveDir Directories="$(PayloadDir)" Condition="'$(AppSelfContained)' == 'true' and '$(SkipAppBuild)' != 'true'" />
    <Exec Condition="'$(AppSelfContained)' == 'true' and '$(SkipAppBuild)' != 'true'"
          Command="dotnet publish &quot;$(AppProject)&quot; -c $(AppConfiguration) -r $(AppRuntimeIdentifier) $(_AppPublishFramework) --self-contained true -p:PublishSingleFile=false $(AppPublishArguments) -o &quot;$(PayloadDir.TrimEnd('\'))&quot; -nologo" />
    <PropertyGroup Condition="'$(AppSelfContained)' == 'true'">
      <_AppAssembly>$(PayloadDir)$(AppAssemblyName).dll</_AppAssembly>
    </PropertyGroup>

    <MSBuild Projects="$(AppProject)" Targets="Build" Properties="$(_AppBuildProperties)"
             Condition="'$(AppSelfContained)' != 'true' and '$(SkipAppBuild)' != 'true'">
      <Output TaskParameter="TargetOutputs" ItemName="_AppTargetPath" />
    </MSBuild>
    <MSBuild Projects="$(AppProject)" Targets="GetTargetPath" Properties="$(_AppBuildProperties)"
             Condition="'$(AppSelfContained)' != 'true' and '$(SkipAppBuild)' == 'true'">
      <Output TaskParameter="TargetOutputs" ItemName="_AppTargetPath" />
    </MSBuild>
    <PropertyGroup Condition="'$(AppSelfContained)' != 'true'">
      <_AppAssembly>@(_AppTargetPath->'%(FullPath)')</_AppAssembly>
      <PayloadDir>@(_AppTargetPath->'%(RootDir)%(Directory)')</PayloadDir>
    </PropertyGroup>

    <Error Condition="!Exists('$(PayloadDir)$(AppExeName)')" Text="$(AppExeName) is not in $(PayloadDir). The app build did not produce it." />

    <!-- The version: explicit, else file version, else assembly version. -->
    <CiwGetFileVersion File="$(_AppAssembly)" Condition="'$(ProductVersion)' == ''">
      <Output TaskParameter="Version" PropertyName="ProductVersion" />
    </CiwGetFileVersion>
    <GetAssemblyIdentity AssemblyFiles="$(_AppAssembly)" Condition="'$(ProductVersion)' == ''">
      <Output TaskParameter="Assemblies" ItemName="_AppIdentity" />
    </GetAssemblyIdentity>
    <PropertyGroup>
      <ProductVersion Condition="'$(ProductVersion)' == ''">@(_AppIdentity->'%(Version)')</ProductVersion>
      <_VersionParts>$([System.Text.RegularExpressions.Regex]::Replace('$(ProductVersion)', '[^0-9.]', ''))</_VersionParts>
      <_VersionMajor>$(_VersionParts.Split('.')[0])</_VersionMajor>
      <_VersionMinor>0</_VersionMinor>
      <_VersionMinor Condition="$(_VersionParts.Split('.').Length) &gt; 1">$(_VersionParts.Split('.')[1])</_VersionMinor>
      <_VersionBuild>0</_VersionBuild>
      <_VersionBuild Condition="$(_VersionParts.Split('.').Length) &gt; 2">$(_VersionParts.Split('.')[2])</_VersionBuild>
    </PropertyGroup>

    <!-- Windows Installer's limits: major and minor 0-255, build 0-65535. A date-style version
         (2026.10.14) would otherwise fail deep inside WiX, or worse, compare wrongly on upgrade. -->
    <Error Condition="'$(_VersionMajor)' == '' or $(_VersionMajor) &gt; 255 or $(_VersionMinor) &gt; 255 or $(_VersionBuild) &gt; 65535"
           Text="Version '$(ProductVersion)' cannot be an installer version: Windows Installer allows major.minor.build up to 255.255.65535. Set &lt;Version&gt; in the app project, or pass -p:ProductVersion=x.y.z." />
    <!-- 1.0.0 can be a real first release, so this only warns: it is also what an app gets when nobody
         set a version, and every later build would then be "the same version" and never upgrade. -->
    <Warning Condition="'$(_VersionMajor).$(_VersionMinor).$(_VersionBuild)' == '1.0.0'"
             Text="Packaging version 1.0.0, the .NET default. If this is not the first release, set &lt;Version&gt; in the app project (or pass -p:ProductVersion=x.y.z): an installer with the same first three version parts does not upgrade the one already installed." />

    <PropertyGroup>
      <DefineConstants>$(DefineConstants);PayloadDir=$(PayloadDir);ProductVersion=$(ProductVersion)</DefineConstants>
    </PropertyGroup>

    <!-- WiX skips recompiling when no source file changed, and neither a new version nor a file added
         to the payload changes one - the old .msi would be shipped under the new number. This stamp
         changes whenever either does, and is made an input of the compile. -->
    <ItemGroup>
      <_PayloadFile Include="$(PayloadDir)**" />
    </ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)payload.stamp" Lines="$(ProductVersion);@(_PayloadFile)"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <PropertyGroup>
      <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildProjectDirectory)\$(IntermediateOutputPath)payload.stamp</MSBuildAllProjects>
    </PropertyGroup>
    <Message Importance="high" Text="Packaging $(PayloadDir) as version $(ProductVersion)" />
  </Target>

  <!--
    Signing. Off unless SignCertificateThumbprint or SignCommand is set. The WiX SDK's signing pipeline
    (SignOutput) then calls the three targets below, which it declares empty for projects to fill in:
      inner build   SignMsi            the .msi, before the bundle embeds it
      outer build   SignBundleEngine   the setup engine, which WiX has detached from the .exe for this
                    SignBundle         the setup .exe, after WiX has reattached the signed engine
    Signing the finished .exe alone is not enough: Burn checks the engine's signature too.

    SignToolPath defaults to the newest signtool.exe in the Windows 10/11 SDK (Visual Studio installs one
    with its C++ or Windows workloads). SignTimestampUrl defaults to DigiCert's public RFC 3161 server, so
    signatures stay valid after the certificate expires.
  -->
  <PropertyGroup Condition="'$(SignCertificateThumbprint)' != '' or '$(SignCommand)' != ''">
    <SignOutput>true</SignOutput>
    <!-- The cabinet is embedded in the .msi, so signing the .msi covers it. -->
    <SignOutputCabs>false</SignOutputCabs>
    <SignTimestampUrl Condition="'$(SignTimestampUrl)' == ''">http://timestamp.digicert.com</SignTimestampUrl>
  </PropertyGroup>

  <Target Name="CiwResolveSignCommand">
    <ItemGroup Condition="'$(SignCommand)' == '' and '$(SignToolPath)' == ''">
      <_CiwSignTool Include="$(MSBuildProgramFiles32)\Windows Kits\10\bin\10.*\x64\signtool.exe" />
    </ItemGroup>
    <PropertyGroup Condition="'$(SignCommand)' == ''">
      <!-- The glob lists SDK versions in ascending order; the last is the newest. -->
      <_CiwSignTools>@(_CiwSignTool->'%(FullPath)')</_CiwSignTools>
      <SignToolPath Condition="'$(SignToolPath)' == '' and '$(_CiwSignTools)' != ''">$(_CiwSignTools.Substring($([MSBuild]::Add($(_CiwSignTools.LastIndexOf(';')), 1))))</SignToolPath>
    </PropertyGroup>
    <Error Condition="'$(SignCommand)' == '' and ('$(SignToolPath)' == '' or !Exists('$(SignToolPath)'))"
           Text="Signing is on (SignCertificateThumbprint), but signtool.exe was not found. Install the Windows SDK, or set SignToolPath to signtool.exe, or SignCommand to a complete signing command." />
    <PropertyGroup Condition="'$(SignCommand)' == ''">
      <SignCommand>&quot;$(SignToolPath)&quot; sign /sha1 $(SignCertificateThumbprint) /fd sha256 /tr $(SignTimestampUrl) /td sha256 /d &quot;$(OutputName)&quot;</SignCommand>
    </PropertyGroup>
  </Target>

  <Target Name="SignMsi" DependsOnTargets="CiwResolveSignCommand">
    <Exec Command="$(SignCommand) &quot;%(SignMsi.FullPath)&quot;" />
  </Target>
  <Target Name="SignBundleEngine" DependsOnTargets="CiwResolveSignCommand">
    <Exec Command="$(SignCommand) &quot;%(SignBundleEngine.FullPath)&quot;" />
  </Target>
  <Target Name="SignBundle" DependsOnTargets="CiwResolveSignCommand">
    <Exec Command="$(SignCommand) &quot;%(SignBundle.FullPath)&quot;" />
  </Target>

</Project>
